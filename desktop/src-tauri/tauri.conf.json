{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScanBridge",
  "version": "0.1.1",
  "identifier": "app.scanbridge.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run frontend:build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScanBridge",
        "width": 420,
        "height": 720,
        "resizable": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Gunakan ponsel sebagai scanner barcode untuk Windows.",
    "longDescription": "ScanBridge mengirim hasil scan barcode dari ponsel ke field aktif di Windows melalui koneksi realtime."
  }
}
